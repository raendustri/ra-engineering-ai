# Bu dosyayi .env adi ile kopyalayin ve KENDINIZI ait guclu bir sifre girin.
# Bu dosyayi asla GitHub'a yuklemeyin.
DASHBOARD_PASSWORD=BURAYA_UZUN_RASTGELE_BIR_SIFRE_YAZIN

# Istege bagli: Yalnizca sunucuda tutulan OpenAI YONETICI API anahtari.
# Bos kalirsa otomatik kullanim bilgisi gosterilemez; manuel bakiye calisir.
OPENAI_ADMIN_KEY=

# Istege bagli: Sadece RA Engineering AI projesini izlemek icin OpenAI proje ID'si.
# Bos kalirsa maliyet ve tokenler organizasyon genelinde gosterilir.
OPENAI_PROJECT_ID=

# Ilk kurulumda bilgisayar disindan erisimi kapali tutar.
# Tailscale/ozel ag ile telefon kullanimi icin 0.0.0.0 yapilabilir.
HOST=127.0.0.1
PORT=4848

# Ancak HTTPS terminasyonu dogru yapilan guvenilir ters vekil arkasinda true yapin.
TRUST_PROXY=false